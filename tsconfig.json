{
  "compilerOptions": {
    "target": "ES2020",             // Modern JS target
    "module": "CommonJS",           // Node requires CommonJS
    "rootDir": "src",               // Ensure TypeScript knows where your source files are
    "outDir": "./dist",             // Compiled files go here
    "strict": true,                 // Enable strict type checking
    "esModuleInterop": true,        // Allow default imports from CommonJS modules
    "skipLibCheck": true,           // Skip type checks of node_modules
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
