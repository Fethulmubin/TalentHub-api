{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@modules/*": ["modules/*"],
      "@services/*": ["services/*"],
      "@workers/*": ["workers/*"],
      "@websocket/*": ["websocket/*"]
    }
  },
  "include": [
    "index.ts",
    "modules/**/*.ts",
    "shared/**/*.ts",
    "shared/**/*.d.ts",
    "services/**/*.ts",
    "workers/**/*.ts",
    "websocket/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "generated"
  ]
}
