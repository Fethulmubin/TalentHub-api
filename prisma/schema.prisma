generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  APPLICANT
  EMPLOYER
}

enum AppStatus {
  APPLIED
  SHORTLISTED
  REJECTED
}

model Skill {
  id    String  @id @default(uuid())
  name  String  @unique
  users User[]  @relation("UserSkills")
  jobs  Job[]   @relation("JobSkills")
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  password        String
  role            Role             @default(APPLICANT)
  jobs            Job[]            @relation("UserJobs")
  apps            Application[]
  skills          Skill[]          @relation("UserSkills")
  resumes         ResumeProfile[]
  gitHubProfile   GitHubProfile?
  candidateMatches CandidateMatch[]
  interviewSessions InterviewSession[]
  createdAt       DateTime         @default(now())
}

model Job {
  id              String            @id @default(uuid())
  title           String
  description     String
  price           Float?
  createdById     String
  createdBy       User              @relation("UserJobs", fields: [createdById], references: [id])
  applications    Application[]
  skills          Skill[]           @relation("JobSkills")
  candidateMatches CandidateMatch[]
  interviewSessions InterviewSession[]
  createdAt       DateTime          @default(now())
}

model Application {
  id              String            @id @default(uuid())
  jobId           String
  userId          String
  status          AppStatus         @default(APPLIED)
  resumeUrl       String?
  createdAt       DateTime          @default(now())

  job             Job               @relation(fields: [jobId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
  interviewScore  InterviewScore?
  behavioralScore BehavioralScore?
  candidateMatch  CandidateMatch?
  interviewSessions InterviewSession[]

  @@unique([jobId, userId])
}

model ResumeProfile {
  id              String             @id @default(uuid())
  userId          String?
  fileName        String
  fileUrl         String
  rawText         String
  skills          String[]           @default([])
  education       Json?              @default("[]")
  yearsExperience Float?
  technologies    String[]           @default([])
  projects        Json?              @default("[]")
  summary         String?
  status          String             @default("PROCESSING")
  errorMessage    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user        User?              @relation(fields: [userId], references: [id])
  embeddings  ResumeEmbedding[]
  insights    CandidateInsight[]

  @@index([userId])
  @@index([status])
}

model ResumeEmbedding {
  id         String   @id @default(uuid())
  resumeId   String
  chunkIndex Int
  chunkText  String
  embedding  Unsupported("vector(384)")?
  createdAt  DateTime @default(now())

  resume ResumeProfile @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model CandidateInsight {
  id          String   @id @default(uuid())
  resumeId    String
  insightType String
  label       String
  value       String
  confidence  Float
  evidence    String
  createdAt   DateTime @default(now())

  resume ResumeProfile @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@index([insightType])
}

model InterviewScore {
  id                String   @id @default(uuid())
  applicationId     String   @unique
  communication     Float    @default(0)
  problemSolving    Float    @default(0)
  technicalDepth    Float    @default(0)
  culturalFit       Float    @default(0)
  overallScore      Float    @default(0)
  notes             String?
  interviewedAt     DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model GitHubProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  username         String
  avatarUrl        String?
  bio              String?
  publicRepos      Int      @default(0)
  followers        Int      @default(0)
  following        Int      @default(0)
  contributions    Int      @default(0)
  languages        String[] @default([])
  topRepos         Json?    @default("[]")
  lastSyncAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model BehavioralScore {
  id                String   @id @default(uuid())
  applicationId     String   @unique
  adaptability      Float    @default(0)
  collaboration     Float    @default(0)
  initiative        Float    @default(0)
  communication     Float    @default(0)
  overallScore      Float    @default(0)
  notes             String?
  assessedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model CandidateMatch {
  id              String   @id @default(uuid())
  jobId           String
  applicationId   String   @unique
  userId          String
  overallScore    Float    @default(0)
  resumeScore     Float    @default(0)
  interviewScore  Float    @default(0)
  githubScore     Float    @default(0)
  behaviorScore   Float    @default(0)
  confidence      Float    @default(0)
  strengths       Json     @default("[]")
  gaps            Json     @default("[]")
  explanation     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@index([jobId])
  @@index([userId])
  @@index([overallScore])
}

enum InterviewPhase {
  GREETING
  CODING
  ORAL
  EVALUATION
  COMPLETED
}

enum SubmissionStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  ERROR
}

model InterviewSession {
  id              String          @id @default(uuid())
  applicationId   String          @unique
  userId          String
  jobId           String
  phase           InterviewPhase  @default(GREETING)
  status          String          @default("SCHEDULED")
  codingPrompt    String?
  starterCode     String?
  language        String          @default("javascript")
  timeLimit       Int             @default(3600)
  timeRemaining   Int             @default(3600)
  startedAt       DateTime?
  completedAt     DateTime?
  codingScore     Float           @default(0)
  oralScore       Float           @default(0)
  overallScore    Float           @default(0)
  transcript      Json            @default("[]")
  metadata        Json            @default("{}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application  Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id])
  job          Job                @relation(fields: [jobId], references: [id])
  submissions  CodingSubmission[]
  testResults  TestResult[]
  questions    InterviewQuestion[]

  @@index([applicationId])
  @@index([userId])
  @@index([jobId])
  @@index([status])
}

model InterviewQuestion {
  id             String   @id @default(uuid())
  sessionId      String
  type           String   @default("coding")
  question       String
  difficulty     String   @default("medium")
  starterCode    String?
  testCases      Json     @default("[]")
  expectedOutput String?
  hints          Json     @default("[]")
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model CodingSubmission {
  id            String           @id @default(uuid())
  sessionId     String
  questionId    String?
  code          String
  language      String           @default("javascript")
  status        SubmissionStatus @default(PENDING)
  output        String?
  errorOutput   String?
  testPassed    Int              @default(0)
  testTotal     Int              @default(0)
  score         Float            @default(0)
  submittedAt   DateTime         @default(now())
  executedAt    DateTime?
  duration      Int?

  session     InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  testResults TestResult[]

  @@index([sessionId])
}

model TestResult {
  id           String   @id @default(uuid())
  submissionId String
  sessionId    String
  testIndex    Int
  name         String?
  passed       Boolean  @default(false)
  input        String?
  expected     String?
  actual       String?
  error        String?
  duration     Int?
  createdAt    DateTime @default(now())

  submission CodingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  session    InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([sessionId])
}
